# ── 虚拟环境与依赖缓存（离线重建靠 .wheels/，两者都不入库）──
.venv/
.wheels/

# ── pip 在 cwd 落下的临时目录（pip-build-tracker-* / pip-unpack-* 等）──
pip-*/

# ── Python 产物 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/

# ── 运行期数据（种子由 tools/seed.py 重建，库文件不入库）──
*.db
*.db-wal
*.db-shm

# ── 评审方的验证沙箱（R 在本机复跑用例时生成，S9 打包前必须删除且不进 zip）──
.verify/

# ── 测试与覆盖率产物 ──
.coverage
coverage.xml
htmlcov/
*.log

# ── 编辑器 / 系统 ──
.vscode/
.idea/
Thumbs.db
~$*
